# ============================================================
# shopify-system/.gitignore
# Depot Git n1 - systeme freelance. AUCUNE donnee client ici.
# ============================================================

# --- Secrets : jamais versionnes, jamais d'exception ---
.env
.env.*
!.env.example

# --- Dependances ---
node_modules/

# --- Outils Shopify ---
.shopify/

# --- Systeme ---
.DS_Store
Thumbs.db
desktop.ini

# --- Journaux ---
*.log
npm-debug.log*

# Pipeline PageSpeed
tools/pagespeed/snapshots/
# URLs reelles d'un client : jamais versionnees. Le .example l'est.
tools/pagespeed/performance-urls.json
tools/pagespeed/.env
tools/pagespeed/node_modules/
